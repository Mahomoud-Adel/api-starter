{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@core/*": [
        "./src/core/*"
      ],
      "@config/*": [
        "./src/config/*"
      ],
      "@db": [
        "./src/database"
      ]
    }
  },
  "include": [
    "src",
    "drizzle.config.ts"
  ]
}